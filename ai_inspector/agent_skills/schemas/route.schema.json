{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspectorp.ro/schemas/skill-route-v2.json",
  "title": "InspectorPro Semantic Skill Route v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_version",
    "speech_act",
    "primary_workflow",
    "continue_existing_workflow",
    "workflow_confidence",
    "intents",
    "skill_candidates",
    "needs_clarification"
  ],
  "properties": {
    "route_version": {"const": 2},
    "speech_act": {"enum": ["question", "explain", "analyze", "command", "edit", "compare", "navigate", "clarify", "social"]},
    "primary_workflow": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}]},
    "continue_existing_workflow": {"type": "boolean"},
    "workflow_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "intents": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/intent"}},
    "skill_candidates": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/skillCandidate"}},
    "needs_clarification": {"type": "boolean"},
    "clarification_question": {"type": "string", "minLength": 1, "maxLength": 240}
  },
  "allOf": [
    {
      "if": {"properties": {"needs_clarification": {"const": true}}},
      "then": {"required": ["clarification_question"]}
    },
    {
      "if": {"properties": {"needs_clarification": {"const": false}}},
      "then": {"not": {"required": ["clarification_question"]}}
    }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label"],
      "properties": {
        "kind": {"enum": ["fai_characteristic", "part", "feature", "motion_group", "assembly", "process_map", "process_node", "operations_manual", "specification_sheet", "parts_manual", "documentation_figure", "facility_layout", "facility_zone", "facility_entity", "facility_placement", "facility_route", "facility_utility_network", "facility_process_binding", "industrial_asset", "viewport", "unknown"]},
        "id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "label": {"type": "string", "maxLength": 160}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targets", "requested_effects", "confidence"],
      "properties": {
        "kind": {"enum": ["assess_fai_characteristic", "explain_assembly_impact", "explain_motion", "visualize_affected_context", "recommend_disposition", "analyze_process_map", "generate_process_map", "generate_operations_manual", "generate_specification_sheet", "publish_specification_sheet", "analyze_specification_sheet", "publish_parts_manual", "analyze_facility_layout", "compare_facility_entities", "visualize_facility_data", "generate_facility_layout", "other"]},
        "targets": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/target"}},
        "requested_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["highlight_parts", "highlight_features", "play_motion", "pause_motion", "stop_motion", "set_motion_rpm", "hide_parts", "show_parts", "set_transparency", "rotate_view", "clear_highlight", "fill_fai", "set_fai_tolerance", "navigate_tab"]}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "skillCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "confidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "role": {"enum": ["primary", "support"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
