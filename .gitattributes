# Source-bound evidence contains byte-level SHA-256 bindings. Keep text bytes
# stable across Windows worktrees instead of allowing core.autocrlf to rewrite
# checked-out files. Binary CAD, image, archive, and GLB assets are unaffected.
.gitattributes text eol=lf
*.css text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
LICENSE text eol=lf
COPYING text eol=lf
