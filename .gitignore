runtime_metrics/
# Server log files written at runtime
runtime_logs/
*.log
*.out
*.err
debug.log
uvicorn-*.log
server_*.log
# Pilot-bundle archives produced by scripts/collect-pilot-bundle.ps1
pilot_diagnostics/
# Raw packages copied in from the SOLIDWORKS bridge before sidecar install
400S_Sorted_Library/_bridge_imports/

# Local test and smoke-test output
.pytest_cache/
.pytest-basetemp-*/
compare-smoke-*.png
highlight-smoke-*.png
racing_training_preview*.png
training_*.png
_drain*.png

