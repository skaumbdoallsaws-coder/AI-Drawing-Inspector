{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inspectorpro:schema:execution-receipt:v1",
  "title": "InspectorPro Browser Execution Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "receipt_id",
    "tool_call_id",
    "action_id",
    "tool_id",
    "status",
    "requested_args",
    "applied_args",
    "before",
    "after",
    "evidence",
    "error",
    "duration_ms",
    "timestamp"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "tool_call_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "action_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "tool_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "status": {"enum": ["succeeded", "failed", "rejected"]},
    "requested_args": {"type": "object"},
    "applied_args": {"type": "object"},
    "before": {"type": "object"},
    "after": {"type": "object"},
    "evidence": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "maxLength": 200}
    },
    "error": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 240}]},
    "duration_ms": {"type": "number", "minimum": 0},
    "timestamp": {"type": "string", "minLength": 1, "maxLength": 60}
  }
}
