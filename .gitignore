_add_*.py
_apply_*.py
_capture_*.py
_edit_*.py
_plot*.py
_probe_*.py
_validate_*.py
server_diff_check.txt
start_uvicorn_8020.ps1

# Large local/demo-library leftovers not required by the committed runtime demo
demo_library/
generated/training/process/cooling-tower/User Library-*
generated/training/racing-bike/_front_wheel_reextract/
