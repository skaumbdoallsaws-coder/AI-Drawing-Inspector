{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspectorp.ro/schemas/skill-manifest-v1.json",
  "title": "InspectorPro Skill Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "description",
    "agents",
    "workflows",
    "modes",
    "requires_context",
    "optional_context",
    "allowed_tools",
    "side_effects",
    "depends_on",
    "conflicts_with",
    "composable_with",
    "evidence_policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 63},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "agents": {"$ref": "#/$defs/tokenListNonEmpty"},
    "workflows": {"$ref": "#/$defs/idListNonEmpty"},
    "modes": {"$ref": "#/$defs/tokenListNonEmpty"},
    "requires_context": {"$ref": "#/$defs/tokenList"},
    "optional_context": {"$ref": "#/$defs/tokenList"},
    "allowed_tools": {"$ref": "#/$defs/tokenList"},
    "side_effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["viewport_write", "asset_write", "system_write"]}
    },
    "depends_on": {"$ref": "#/$defs/idList"},
    "conflicts_with": {"$ref": "#/$defs/idList"},
    "composable_with": {"$ref": "#/$defs/idList"},
    "evidence_policy": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$", "maxLength": 80}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "tokenList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "tokenListNonEmpty": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "idList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "idListNonEmpty": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
