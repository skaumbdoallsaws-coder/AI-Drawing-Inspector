{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspectorp.ro/schemas/workflow-manifest-v1.json",
  "title": "InspectorPro Workflow Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "description",
    "agents",
    "entry_signals",
    "required_assets",
    "optional_assets",
    "stages",
    "completion"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 63},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "agents": {"$ref": "#/$defs/tokenListNonEmpty"},
    "entry_signals": {"$ref": "#/$defs/textListNonEmpty"},
    "required_assets": {"$ref": "#/$defs/tokenList"},
    "optional_assets": {"$ref": "#/$defs/tokenList"},
    "stages": {"$ref": "#/$defs/tokenListNonEmpty"},
    "completion": {"$ref": "#/$defs/textListNonEmpty"}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "tokenList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "tokenListNonEmpty": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "textListNonEmpty": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
