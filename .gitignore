# Python
__pycache__/
*.py[cod]
*.so
.Python
env/
venv/
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Large files (don't commit these - upload separately to Colab)
*.pkl
*.bin
*.pt
*.pth
*.safetensors

# Data files
*.json
# Allow SolidWorks-verified context databases
!sw_parts_db.json
!sw_assemblies_db.json
!sw_mating_context.json
!sw_structure.json
!sw_components_all.json
!sw_mate_specs.json
!sw_inspector_requirements.json

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test / notebook checkpoints
tests/notebooks/.ipynb_checkpoints/

# Pipeline output
debug/
qc_output/

# Model exports
*.onnx

# Local SolidWorks data
sw_json_library/

# Dataset configs (allow callouts.yaml placeholder)
datasets/*.yaml
!datasets/callouts.yaml

# Generated runtime artifacts -- never check these in
# Local SQLite telemetry store (created at runtime by ai_inspector.telemetry)
runtime_metrics/
# Server log files written at runtime
runtime_logs/
# Pilot-bundle archives produced by scripts/collect-pilot-bundle.ps1
pilot_diagnostics/
# Raw packages copied in from the SOLIDWORKS bridge before sidecar install
400S_Sorted_Library/_bridge_imports/

# .NET build output -- SolidWorksExtractor.csproj writes bin/Debug/,
# bin/Release/, obj/ on every `dotnet build`. Should never be tracked.
SolidWorksExtractor/bin/
SolidWorksExtractor/obj/
